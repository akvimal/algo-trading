        -160,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Chartink sends comma-separated stocks/trigger_prices in one alert.\n// This workflow's path fixes the action - no scan-name lookup needed.\n// Pull from the Webhook node explicitly - by this point in the chain,\n// $input/$json is the Archive-raw-payload HTTP response, not the alert.\nconst body = $('Webhook: chartink-buy').first().json.body;\nconst strategyId = $('Webhook: chartink-buy').first().json.query.strategy_id;\nif (!strategyId) {\n  throw new Error('missing ?strategy_id= on the webhook URL');\n}\n\nconst symbols = String(body.stocks || '').split(',').map(s => s.trim()).filter(Boolean);\nconst prices = String(body.trigger_prices || '').split(',').map(p => parseFloat(p.trim()));\nconst scanName = body.scan_name || body.alert_name || null;\n\nreturn symbols.map((symbol, i) => ({\n  json: {\n    symbol,\n    strategy_id: strategyId,\n    action: 'BUY',\n    exchange: 'NSE',  // Chartink scans in this repo are NSE-only for now\n    price: prices[i] ?? null,\n    timestamp: new Date().toISOString(),\n    source: 'chartink',\n    source_meta: { scan_name: scanName, alert_name: body.alert_name ?? null }\n  }\n}));"
      },
      "id": "normalize-fanout",
      "name": "Normalize + fan-out",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SIGNAL_PROCESSING_BACKEND_URL }}/signals",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "post-signal",
      "name": "POST /signals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: \"ok\", received: $items().length } }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        560,
