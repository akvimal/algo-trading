# Copy to .env and adjust before running `docker compose up`.

# --- Postgres (shared instance, one schema per system) ---
POSTGRES_USER=algotrading
POSTGRES_PASSWORD=changeme
POSTGRES_DB=algotrading
# 5433, not Postgres' own default 5432 - avoids colliding with another
# app's own Postgres container on the same host (a real conflict found
# deploying to a VPS already running other docker-compose stacks).
POSTGRES_PORT=5433

# --- Redis (signal-engine -> execution stream) ---
REDIS_PORT=6379

# --- signal-engine (Strategy/Rule CRUD + in-house engine, merged with
# webhook intake/resolution 2026-08-28 - see docs/architecture.md) ---
SIGNAL_ENGINE_BACKEND_PORT=8000
# 8085, not 8080 - 8080 is one of the most commonly-used default ports for
# other tools (Portainer, Jenkins, etc.), so it's the single most likely
# collision on a host already running other containers. If you change
# this, also update shell/index.html's own TABS array (a plain static
# page with no build step, so it hardcodes this port rather than reading
# it from .env at runtime).
SIGNAL_ENGINE_FRONTEND_PORT=8085

# --- market-data (Dhan - NSE quotes) ---
# Leave these EMPTY. Dhan tokens are entered on the web app's Settings page (More -> Settings -> Broker & live) and nowhere else: the platform
# (background scans, shared feed, option-chain reads) follows the token the operator saves there, renews it, and saves the renewed token back.
# A value here is only a last-resort starting point for a brand-new stack that nobody has signed in to yet, and is replaced by the saved token.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# market-data renews the platform's Dhan token once it is this many hours OLD (read from the token itself: a token lives 24 hours), checking every
# 10 minutes. It waits for a running end-of-day scan to finish unless under 3 hours remain, because Dhan's renewal replaces the token. Default 12,
# so there are two attempts a day. Set to 0 to disable - do this in any stack sharing a Dhan account/token with another already-renewing stack
# (see .env.test), since only one should ever renew it.
DHAN_TOKEN_RENEW_INTERVAL_HOURS=12
# The platform's Dhan token (background scans, shared feed) is the one the operator saves on the Settings page: true (default) adopts it and saves
# renewed tokens back there; false keeps a separate platform token. PLATFORM_DHAN_OWNER_EMAIL picks whose saved keys (empty: the first admin).
PLATFORM_DHAN_FROM_ACCOUNTS=true
PLATFORM_DHAN_OWNER_EMAIL=
# Manual override for Dhan's own instrument-master lot-size data, confirmed
# wrong for MCX commodities (every FUTCOM row reports 1 regardless of real
# contract size). A mini/micro variant is NOT automatically the same
# multiplier as its full-size sibling - see app/config.py for the
# per-commodity trading-unit/quotation-unit derivation. "underlying:qty"
# pairs, comma-separated.
MCX_LOT_SIZE_OVERRIDES=GOLD:100,GOLDM:10,CRUDEOIL:100,CRUDEOILM:10,SILVER:30,SILVERM:5,SILVERMIC:1,SILVER100:10,NATURALGAS:1250,NATGASMINI:250
# Standalone price alerts (manual-trading's "Alerts" tab) push here when
# fired - create a bot via @BotFather for the token, then message it and
# read https://api.telegram.org/bot<token>/getUpdates for your chat id.
# Both blank = alerts still work in the UI, nothing gets pushed to a phone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# A SEPARATE bot (create another with @BotFather) for publishing notes as "ideas" to a channel or group - operator only, set the
# destination in the app (Notes). Add the bot to the channel as an admin that can post. Every idea ends with a disclaimer: leave
# IDEAS_DISCLAIMER empty for the built-in "not investment advice" notice, or set your own wording (have it reviewed by counsel);
# IDEAS_REGISTRATION_LINE is appended after it (for example a SEBI registration number), if you have one to show.
TELEGRAM_IDEAS_BOT_TOKEN=
IDEAS_DISCLAIMER=
IDEAS_REGISTRATION_LINE=
MARKET_DATA_BACKEND_PORT=8001
MARKET_DATA_FRONTEND_PORT=8083
# OpenRouter (openrouter.ai) - turns the raw RSS headlines (free, no key -
# see app/providers/news.py) into an AI trend-relevance digest (bias +
# filtered/scored articles) for the Live Chart's News tab. Blank = the tab
# falls back to the plain unscored headlines. Text-only - see
# OPENROUTER_VISION_MODEL below for signal-engine's separate (vision) call.
OPENROUTER_API_KEY=
# google/gemini-2.5-flash-lite (2026-09-22) - a cheap OpenRouter alternative
# to Claude Haiku for this text-only digest; swap freely, this call site has
# no vision requirement.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Model for market-data's on-demand OI-strip "AI read" (GET /ai-read).
OPENROUTER_READ_MODEL=openai/gpt-6-luna-pro
# signal-engine's Weekly Advisor fundamentals (app/domain/weekly_advisor/
# screener_fetch.py) - same OPENROUTER_API_KEY above, but its own model
# setting since this call sends a screener.in screenshot and needs a
# vision-capable model; independent from OPENROUTER_MODEL above so the two
# call sites can be pointed at different models. Same google/gemini-2.5-
# flash-lite default - confirmed vision-capable and working live against
# this exact call site 2026-09-22 (the moneycontrol pre-market trial used
# the non-lite google/gemini-2.5-flash; flash-lite is the same family).
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite

# --- execution (docker compose --profile execution up -d) ---
EXECUTION_BACKEND_PORT=8002
EXECUTION_FRONTEND_PORT=8081

# --- accounts (identity + BYO Dhan/Delta credential storage for the
# manual-trading SaaS, Phases 1-3 - docker compose --profile execution up -d;
# execution and market-data both consume it as of Phase 2/3) ---
ACCOUNTS_BACKEND_PORT=8004
# Signs/verifies login tokens - any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCOUNTS_JWT_SECRET=change-me-to-a-random-string

# signal-engine: require a login and scope strategies/rules/indicators/
# watchlists/backtests/signals to their creator (admins see all; rows with no
# owner become admin-only). Leave false until (1) migration
# infra/postgres/migrations/014-signal-engine-ownership.sql is applied,
# (2) every frontend/script that calls signal-engine sends a token (the
# frontends and shell do as of 2026-09-25; scripts/simulate-chartink-alert.sh
# needs AUTH_TOKEN). The Chartink webhooks and the Weekly Advisor routes are
# NOT covered - see docs/redesign-rollout-plan.md, Phase 0.
SIGNAL_ENGINE_REQUIRE_AUTH=false
# Encrypts stored Dhan/Delta credentials at rest - same generation command
# as above works (any string is SHA-256'd down to a key internally, see
# app/domain/security.py). Rotating this makes previously-saved
# credentials undecryptable - users would need to re-enter them.
ACCOUNTS_CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-random-string
# Shared secret between accounts-backend and market-data-backend only
# (Phase 3, BYO Dhan credentials) - protects accounts' internal
# GET /internal/credentials/{user_id}/dhan route, which returns a
# decrypted plaintext secret to a trusted service caller instead of a
# person. Same generation command as above works.
INTERNAL_SERVICE_SECRET=change-me-to-a-random-string
# Live-broker-adapter P0 (see docs/architecture.md) - shared-secret PATH
# segment for Dhan's own order-update postback. Register
# https://<this-host>/dhan/order-update/<this-value> with Dhan as the
# postback URL, never the bare /dhan/order-update path - Dhan doesn't
# cryptographically sign postback requests, so this is the only thing
# keeping the URL from being spoofable by anyone who guesses it.
DHAN_POSTBACK_SECRET=change-me-to-a-random-string
# Platform-wide instant-stop for real order submission (execution-backend) -
# an env var, not a DB row, so it can be flipped without a DB write in the
# loop. true BLOCKS real order submission for every account at once,
# regardless of any account's own live_trading_enabled opt-in. Leave false
# (not killed) - each account's own live_trading_enabled (defaults false,
# paper-only) is the separate, actual opt-in.
LIVE_TRADING_KILL_SWITCH=false
# Paper track-record gate: when true, a user can only turn live trading ON for
# their own NSE/MCX account after a paper record (enough trades recorded WITH
# costs, days on the record, discipline score, max drawdown, net profit, costs
# switched on). Off by default. Progress: GET /live-eligibility/{segment}.
# The thresholds below are product judgments to tune, not measurements.
REQUIRE_PAPER_TRACK_RECORD=false
# Own-keys data model: when true, live Dhan-backed market data (quotes, candles,
# option chains, order blocks, the regime badge, sentiment, the quote WebSocket) is
# only served to a SIGNED-IN user with their OWN saved Dhan keys and never falls back
# to the shared platform credential (crypto, source=yahoo and the EOD screeners are
# unaffected). execution and signal-engine keep working as trusted services. Off by
# default. Before flipping it: users need somewhere to add their Dhan keys, and see
# docs/architecture.md, "Own-keys data model", for the residual platform-key use.
REQUIRE_OWN_DHAN_KEYS=false
# ...and the execution side of it: when true, the automated jobs that watch users' positions
# fetch quotes per OWNER on that owner's own Dhan keys instead of one batch on the platform
# credential. The fallback (default true) uses the platform credential for an owner whose own
# keys are missing or expired, so their stop-losses keep being enforced. Off by default.
JOB_QUOTES_USE_OWNER_KEYS=false
JOB_QUOTES_PLATFORM_FALLBACK=true
TRACK_RECORD_MIN_TRADES=30
TRACK_RECORD_MIN_DAYS=14
TRACK_RECORD_MIN_DISCIPLINE=60
TRACK_RECORD_MAX_DRAWDOWN_PCT=20
TRACK_RECORD_MIN_SLIPPAGE_BPS=3


# --- manual-trading (Manual Trading + Options OI; frontend-only, calls
# execution/market-data directly - docker compose --profile execution up -d) ---
MANUAL_TRADING_FRONTEND_PORT=8084

# --- web: the redesigned responsive app (Phase 2 of docs/redesign-rollout-plan.md;
# frontend-only, --profile execution). Test stack: set 9095 in .env.test. ---
WEB_FRONTEND_PORT=8095

# --- tab shell (nav across all frontends) ---
SHELL_PORT=8090

# --- TLS reverse proxy (VPS-only - docker-compose.prod.yml, never used by
# local dev/test) ---
# Your free DuckDNS (or other) subdomain, already pointed at this VPS's
# public IP. Caddy (see infra/caddy/Caddyfile) requests one Let's Encrypt
# cert for this hostname and reuses it across every port above - a cert is
# scoped to a hostname, not a port, so no per-service subdomain is needed.
# Blank/unset is fine for local dev - docker-compose.prod.yml (and the
# caddy service it adds) is never part of the local `make up`/`make
# test-up` stacks.
VPS_DOMAIN=
# Leave blank locally (every service publishes to 0.0.0.0 as before). Set
# to 127.0.0.1 ONLY on a VPS running docker-compose.prod.yml's Caddy
# service - see docker-compose.yml's own top-of-file comment.
BIND_ADDR=
