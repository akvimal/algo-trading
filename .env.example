# Copy to .env and adjust before running `docker compose up`.

# --- Postgres (shared instance, one schema per system) ---
POSTGRES_USER=algotrading
POSTGRES_PASSWORD=changeme
POSTGRES_DB=algotrading
POSTGRES_PORT=5432

# --- Redis (signal-processing -> execution stream) ---
REDIS_PORT=6379

# --- signal-processing ---
SIGNAL_PROCESSING_BACKEND_PORT=8000
SIGNAL_PROCESSING_FRONTEND_PORT=8080

# --- market-data (Dhan - NSE quotes) ---
# From your Dhan account -> API access. Dhan access tokens are
# login-generated and can expire; regenerate if quotes start failing.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
# market-data auto-renews the access token before it expires (default
# 20h cadence). Set to 0 to disable - do this in any stack sharing a
# Dhan account/token with another already-auto-renewing stack (see
# .env.test), since only one should ever renew it automatically.
DHAN_TOKEN_RENEW_INTERVAL_HOURS=20
# Manual override for Dhan's own instrument-master lot-size data, confirmed
# wrong for MCX commodities (every FUTCOM row reports 1 regardless of real
# contract size). A mini/micro variant is NOT automatically the same
# multiplier as its full-size sibling - see app/config.py for the
# per-commodity trading-unit/quotation-unit derivation. "underlying:qty"
# pairs, comma-separated.
MCX_LOT_SIZE_OVERRIDES=GOLD:100,GOLDM:10,CRUDEOIL:100,CRUDEOILM:10,SILVER:30,SILVERM:5,SILVERMIC:1,SILVER100:10,NATURALGAS:1250,NATGASMINI:250
MARKET_DATA_BACKEND_PORT=8001
MARKET_DATA_FRONTEND_PORT=8083

# --- execution (docker compose --profile execution up -d) ---
EXECUTION_BACKEND_PORT=8002
EXECUTION_FRONTEND_PORT=8081

# --- signal-generation (strategy CRUD; engine/backtesting not yet integrated) ---
SIGNAL_GENERATION_BACKEND_PORT=8003
SIGNAL_GENERATION_FRONTEND_PORT=8082

# --- tab shell (nav across all frontends) ---
SHELL_PORT=8090
